<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="sam.GrafoBFS">
  <grid id="bfsRoot" binding="rootPanel" layout-manager="GridBagLayout" row-count="7" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="6">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints><xy x="20" y="20" width="1080" height="800"/></constraints><properties/><border type="none"/>
    <children>
      <component id="bfsTitle" class="javax.swing.JLabel" binding="titleLabel"><constraints><grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><font size="20" style="1"/><text value="SAM · Rutas universitarias mediante BFS"/></properties></component>
      <component id="bfsOriginLabel" class="javax.swing.JLabel" binding="originLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Origen"/></properties></component>
      <component id="bfsDestinationLabel" class="javax.swing.JLabel" binding="destinationLabel"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Destino"/></properties></component>
      <component id="bfsOrigin" class="javax.swing.JComboBox" binding="originCombo"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="10" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="bfsDestination" class="javax.swing.JComboBox" binding="destinationCombo"><constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="10" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="bfsRun" class="javax.swing.JButton" binding="runButton"><constraints><grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar ruta"/></properties></component>
      <component id="bfsStep" class="javax.swing.JButton" binding="stepButton"><constraints><grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Siguiente paso"/></properties></component>
      <component id="bfsStart" class="javax.swing.JButton" binding="startButton"><constraints><grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Iniciar demostración"/></properties></component>
      <component id="bfsReset" class="javax.swing.JButton" binding="resetButton"><constraints><grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Reiniciar búsqueda"/></properties></component>
      <component id="bfsCanvas" class="javax.swing.JPanel" binding="drawingPanel"><constraints><grid row="3" column="0" row-span="3" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" weightx="1.0" weighty="1.0"/></constraints><properties/></component>
      <component id="bfsQueue" class="javax.swing.JLabel" binding="queueLabel"><constraints><grid row="4" column="2" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Cola: —"/></properties></component>
      <component id="bfsResults" class="javax.swing.JTextArea" binding="resultArea"><constraints><grid row="5" column="2" row-span="2" col-span="2" vsize-policy="6" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" weightx="1.0" weighty="0.8"/></constraints><properties><text value="Nodos visitados y ruta aparecerán aquí."/></properties></component>
      <component id="bfsEmptyLabel" class="javax.swing.JLabel" binding="infoLabel"><constraints><grid row="6" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="La ruta mínima cuenta conexiones, no distancia."/></properties></component>
    </children>
  </grid>
</form>