<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="anderson.ArbolAVL">
  <grid id="avlRoot" binding="rootPanel" layout-manager="GridBagLayout" row-count="8" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="6">
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints><xy x="20" y="20" width="1050" height="800"/></constraints><properties/><border type="none"/>
    <children>
      <component id="avlTitle" class="javax.swing.JLabel" binding="titleLabel"><constraints><grid row="0" column="0" row-span="1" col-span="4" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><font size="20" style="1"/><text value="ANDERSON · Registros de pacientes con árbol AVL"/></properties></component>
      <component id="avlCodeLabel" class="javax.swing.JLabel" binding="codeLabel"><constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Código"/></properties></component>
      <component id="avlNameLabel" class="javax.swing.JLabel" binding="nameLabel"><constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Nombre"/></properties></component>
      <component id="avlAgeLabel" class="javax.swing.JLabel" binding="ageLabel"><constraints><grid row="1" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Edad"/></properties></component>
      <component id="avlReasonLabel" class="javax.swing.JLabel" binding="reasonLabel"><constraints><grid row="1" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/></constraints><properties><text value="Motivo administrativo"/></properties></component>
      <component id="avlCode" class="javax.swing.JTextField" binding="codeField"><constraints><grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="10" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="avlName" class="javax.swing.JTextField" binding="nameField"><constraints><grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="10" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="avlAge" class="javax.swing.JTextField" binding="ageField"><constraints><grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="10" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="avlReason" class="javax.swing.JTextField" binding="reasonField"><constraints><grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="10" fill="1" indent="0" use-parent-layout="false"/></constraints><properties/></component>
      <component id="avlInsert" class="javax.swing.JButton" binding="insertButton"><constraints><grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Registrar"/></properties></component>
      <component id="avlSearch" class="javax.swing.JButton" binding="searchButton"><constraints><grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Buscar por código"/></properties></component>
      <component id="avlDelete" class="javax.swing.JButton" binding="deleteButton"><constraints><grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Eliminar código"/></properties></component>
      <component id="avlReset" class="javax.swing.JButton" binding="resetButton"><constraints><grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Reiniciar árbol"/></properties></component>
      <component id="avlDemoLL" class="javax.swing.JButton" binding="demoLLButton"><constraints><grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Demo LL"/></properties></component>
      <component id="avlDemoRR" class="javax.swing.JButton" binding="demoRRButton"><constraints><grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Demo RR"/></properties></component>
      <component id="avlDemoLR" class="javax.swing.JButton" binding="demoLRButton"><constraints><grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Demo LR"/></properties></component>
      <component id="avlDemoRL" class="javax.swing.JButton" binding="demoRLButton"><constraints><grid row="4" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/></constraints><properties><text value="Demo RL"/></properties></component>
      <component id="avlCanvas" class="javax.swing.JPanel" binding="drawingPanel"><constraints><grid row="5" column="0" row-span="1" col-span="4" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" weightx="1.0" weighty="1.0"/></constraints><properties/></component>
      <component id="avlResults" class="javax.swing.JTextArea" binding="resultArea"><constraints><grid row="6" column="0" row-span="2" col-span="4" vsize-policy="6" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false" weightx="1.0" weighty="0.3"/></constraints><properties><text value="Altura y factor de equilibrio aparecerán aquí."/></properties></component>
    </children>
  </grid>
</form>